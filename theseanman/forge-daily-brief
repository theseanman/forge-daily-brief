def sha(b):
    return hashlib.sha256(b).hexdigest()

def main():
    if not os.path.exists(TARGET):
        sys.exit("ERR  %s not found.\n     cd ~/Desktop/forge-daily-brief first, and check you are on gh-pages." % TARGET)

    cur = open(TARGET, "rb").read()
    got = sha(cur)
    if got == POST:
        print("OK   planner.html is ALREADY at install14. Nothing to do.")
        return
    if got != PRE:
        print("STOP planner.html is not the version this patch was built against.")
        print("     expected %s" % PRE)
        print("     found    %s" % got)
        print("     Nothing was changed. Send both hashes to Claude before doing anything else.")
        sys.exit(1)

    new = gzip.decompress(base64.b64decode(PAYLOAD))
    if sha(new) != POST:
        sys.exit("STOP embedded payload is corrupt - the paste was truncated. Nothing was changed.")

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = "%s.install14.bak-%s" % (TARGET, stamp)
    open(backup, "wb").write(cur)

    open(TARGET, "wb").write(new)

    check = sha(open(TARGET, "rb").read())
    if check != POST:
        open(TARGET, "wb").write(cur)
        sys.exit("STOP write verification failed. planner.html was restored from memory. Nothing changed.")

    print("OK   planner.html patched.")
    print("     backup: %s" % backup)
    print("")
    print("Next, one command per line:")
    print("  git add planner.html")
    print("  git commit -m \"install14: mushin + project timers\"")
    print("  git pull --rebase")
    print("  git push")
    print("")
    print("No workflow run needed. This file is hand-maintained.")

if __name__ == "__main__":
    main()
